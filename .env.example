PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string (required for database persistence)
MONGODB_URI=

# JWT signing secret (generate a strong 64-char random string)
JWT_SECRET=

# Google Gemini API key (automatically injected in AI Studio Secrets)
GEMINI_API_KEY=

# Cloudinary credentials for persistent service & issue photo uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay test/live credentials for Indian payment processing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend origin URL for CORS configuration
FRONTEND_URL=http://localhost:3000
